TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# AI spend. TypeSafe reports tokens, not dollars, so Hearth shows a labelled
# estimate. Defaults to $42 per billion tokens; override here. For split rates,
# set the two per-million values instead and they take precedence.
TYPESAFE_PRICE_PER_BTOK=42
TYPESAFE_PRICE_INPUT_PER_MTOK=
TYPESAFE_PRICE_OUTPUT_PER_MTOK=
